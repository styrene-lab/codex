{
  "name": "flynt-editor-bridge-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Flynt editor bridge compatibility adapter. Owns the public window.FlyntEditor API while the legacy CM6 setup still creates EditorView.",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=../../assets/vendor/editor_bridge.bundle.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:dev": "esbuild src/index.ts --bundle --format=iife --target=es2020 --sourcemap --outfile=../../assets/vendor/editor_bridge.bundle.js --define:process.env.NODE_ENV=\\\"development\\\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.6"
  }
}
