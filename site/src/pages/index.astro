---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopNav from "../components/TopNav.astro";
import ScreenshotCard from "../components/ScreenshotCard.astro";
import screenshots from "../data/screenshots.json";

const featuredScreenshots = screenshots.slice(0, 3);

const valueCards = [
  ["Project state stays local", "Markdown notes, task files, drawings, diagrams, boards, flows, and local indexes live in the project folder. Flynt adds structure without taking ownership away from the filesystem."],
  ["Omegon is embedded, not bolted on", "The agent panel runs a project-scoped ACP session with Flynt-native tools, runtime diagnostics, bounded stale-tool handling, and a dedicated Project → Omegon surface."],
  ["Surfaces over file chaos", "Write, Lenses, Graph, Tasks, Design, Terminal, and Omegon organize project work by intent while preserving plain files under the hood."],
  ["Visual artifacts are first-class", "D2 diagrams, Excalidraw drawings, design boards, and flow graphs are treated as project artifacts instead of orphaned render files."],
  ["Inspectable automation", "Tool calls, preflight state, session controls, and release diagnostics are visible. 0.13.0 adds a review-first Apple Notes migration path and tighter document-write, visual-artifact, and distribution boundaries."],
  ["Sync is explicit", "Git-backed sync exists for local-first workflows, with safety hardening in progress. Flynt does not pretend sync is magic collaborative lockstep."],
];
const surfaces = [["Write", "Markdown + tabs"], ["Lenses", "Saved live views"], ["Graph", "Project links"], ["Tasks", "Kanban boards"], ["Design", "Drawings + boards"], ["Terminal", "Shell sessions"], ["Omegon", "Agent state"], ["Sync", "Git-backed state"]];
---
<BaseLayout>
  <TopNav />
  <main class="landing-shell">
    <section class="hero-grid">
      <div>
        <div class="kicker">Flynt 0.13.0</div>
        <h1>Local-first project command center.</h1>
        <p class="hero-lead">Flynt is a project workspace for markdown, tasks, diagrams, saved views, and embedded Omegon agents — built around files you own.</p>
        <p class="hero-copy">0.13.0 adds selective Apple Notes migration on macOS, safer Markdown/frontmatter writes, unified visual-artifact opening, and a smaller validated distribution package for local-first work across Macs.</p>
        <div class="cta-row"><a class="btn btn-primary" href="https://github.com/styrene-lab/flynt/releases/latest">Download latest</a><a class="btn btn-secondary" href="/docs/getting-started/">First-timer guide</a><a class="btn btn-secondary" href="/docs/apple-notes/">Coming from Apple Notes?</a><a class="btn btn-secondary" href="/docs/obsidian/">Coming from Obsidian?</a></div>
        <div class="proof-row"><span>Markdown-native</span><span>Local-first</span><span>Project-scoped agent</span><span>No Flynt cloud account</span></div>
      </div>
      <aside class="release-card">
        <div class="eyebrow">Current release</div><div class="release-version">v0.13.0</div>
        <p>Feature release centered on operator-controlled migration and safer project boundaries: browse and review Apple Notes before copying, preserve provenance, open visual artifacts consistently, and ship a clean signed macOS bundle.</p>
        <div class="status-list">
          <div class="status-row"><strong>macOS</strong><span class="badge">signed app</span></div>
          <div class="status-row"><strong>Migration</strong><span class="badge">Apple Notes</span></div>
          <div class="status-row"><strong>State model</strong><span class="badge">.flynt/</span></div>
          <div class="status-row"><strong>Sync</strong><span class="badge">folder + Git</span></div>
        </div>
      </aside>
    </section>
    <section class="section"><div class="section-heading"><div class="section-kicker">Why it exists</div><h2>The project should be legible to both operator and agent.</h2></div><div class="value-grid">{valueCards.map(([title, body]) => <article class="value-card"><h3>{title}</h3><p>{body}</p></article>)}</div></section>
    <section class="section"><div class="section-heading"><div class="section-kicker">Workspace surfaces</div><h2>One project, multiple operational views.</h2></div><div class="surface-map">{surfaces.map(([title, body]) => <div class="surface-chip"><strong>{title}</strong><span>{body}</span></div>)}</div></section>
    <section class="section"><div class="section-heading"><div class="section-kicker">Demo vault screenshots</div><h2>Release docs should show the product, not just describe it.</h2></div><div class="screenshot-grid">{featuredScreenshots.map((shot) => <ScreenshotCard {...shot} />)}</div></section>
    <section class="section callout"><strong>0.13.0 posture:</strong> Apple Notes import is an explicit copy operation, not background sync. iCloud Drive can replicate a project folder between your Macs, but Flynt does not claim real-time collaboration or automatic conflict resolution.</section>
  </main>
  <footer class="footer"><a href="https://github.com/styrene-lab/flynt">GitHub</a> · <a href="https://github.com/styrene-lab/flynt/releases">Releases</a> · <a href="https://demo.flynt.styrene.io">Demo Vault</a> · © 2024–2026 Black Meridian, LLC · Styrene Labs</footer>
</BaseLayout>
