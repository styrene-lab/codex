{
  "schema_version": 1,
  "id": "qbf-release-flow",
  "meta": { "title": "Release Flow" },
  "nodes": [
    {"id":"brief","kind":"input","position":[80,180],"data":{"name":"Brief"},"sockets":[{"name":"release","direction":"output","ty":"Release"}]},
    {"id":"review","kind":"decision","position":[340,180],"data":{"name":"Review"},"sockets":[{"name":"release","direction":"input","ty":"Release"},{"name":"pass","direction":"output","ty":"Release"},{"name":"fix","direction":"output","ty":"Issue"}]},
    {"id":"validate","kind":"step","position":[620,100],"data":{"name":"Validate"},"sockets":[{"name":"release","direction":"input","ty":"Release"},{"name":"artifact","direction":"output","ty":"Artifact"}]},
    {"id":"rework","kind":"step","position":[620,280],"data":{"name":"Rework"},"sockets":[{"name":"issue","direction":"input","ty":"Issue"},{"name":"release","direction":"output","ty":"Release"}]},
    {"id":"ship","kind":"output","position":[900,100],"data":{"name":"Ship"},"sockets":[{"name":"artifact","direction":"input","ty":"Artifact"}]}
  ],
  "edges": [
    {"id":"e-brief-review","source":{"node":"brief","socket":"release"},"target":{"node":"review","socket":"release"}},
    {"id":"e-review-validate","source":{"node":"review","socket":"pass"},"target":{"node":"validate","socket":"release"}},
    {"id":"e-review-rework","source":{"node":"review","socket":"fix"},"target":{"node":"rework","socket":"issue"}},
    {"id":"e-rework-review","source":{"node":"rework","socket":"release"},"target":{"node":"review","socket":"release"}},
    {"id":"e-validate-ship","source":{"node":"validate","socket":"artifact"},"target":{"node":"ship","socket":"artifact"}}
  ]
}
