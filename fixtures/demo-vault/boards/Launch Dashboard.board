{
  "version": 1,
  "theme": "alpharius",
  "grid": { "cols": 12, "rows": 7, "gap": 10 },
  "cells": [
    {
      "id": "hero", "x": 0, "y": 0, "w": 8, "h": 3,
      "content": { "kind": "html", "html": "<div class='h-full flex flex-col justify-center gap-3 rounded-xl border border-border bg-card p-6'><div class='text-sm uppercase tracking-widest text-primary'>QBF release</div><div class='text-4xl font-bold tracking-tight text-foreground'>One project. Every surface.</div><p class='text-sm text-muted-foreground'>A minimal fixture with complete coverage and no filler.</p><div><span class='rounded-full border border-border px-3 py-1 text-sm text-primary'>In review</span></div></div>" }
    },
    {
      "id": "stats", "x": 8, "y": 0, "w": 4, "h": 3,
      "content": { "kind": "html", "html": "<div class='h-full grid grid-cols-2 gap-3 p-3'><div class='rounded-lg border border-border bg-card p-4'><div class='text-3xl font-bold'>5</div><div class='text-sm text-muted-foreground'>surfaces</div></div><div class='rounded-lg border border-border bg-card p-4'><div class='text-3xl font-bold'>6</div><div class='text-sm text-muted-foreground'>task states</div></div><div class='rounded-lg border border-border bg-card p-4'><div class='text-3xl font-bold'>4</div><div class='text-sm text-muted-foreground'>visual types</div></div><div class='rounded-lg border border-border bg-card p-4'><div class='text-3xl font-bold'>0</div><div class='text-sm text-muted-foreground'>filler notes</div></div></div>" }
    },
    {
      "id": "status", "x": 0, "y": 3, "w": 6, "h": 3,
      "content": { "kind": "html", "html": "<div class='h-full flex flex-col gap-4 rounded-xl border border-border bg-card p-5'><div class='text-xl font-semibold'>Release gate</div><div class='flex items-center justify-between rounded-lg bg-background p-3'><span>Fixture contract</span><span class='text-primary'>Passed</span></div><div class='flex items-center justify-between rounded-lg bg-background p-3'><span>Visual review</span><span class='text-muted-foreground'>Blocked</span></div><button class='mt-auto rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground'>Open runbook</button></div>" }
    },
    {
      "id": "route", "x": 6, "y": 3, "w": 6, "h": 3,
      "content": { "kind": "html", "html": "<div class='h-full flex flex-col rounded-xl border border-border bg-card p-5'><div class='text-xl font-semibold'>Critical path</div><p class='mt-3 text-sm text-muted-foreground'>Brief → Architecture → Review → Validate → Ship</p><div class='mt-auto grid grid-cols-3 gap-2 text-center text-sm'><div class='rounded bg-background p-3'>Write</div><div class='rounded bg-background p-3'>Design</div><div class='rounded bg-background p-3'>Tasks</div></div></div>" }
    }
  ]
}
